{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "next typegen apps/web && tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "build": "tsc -p tsconfig.build.json && next build apps/web --webpack",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "start:api": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/apps/worker/src/main.js",
    "start:web": "next start apps/web --hostname 127.0.0.1",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.2.0",
    "fastify": "5.12.3",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true,
    "@embedded-postgres/darwin-arm64@17.10.0-beta.17": true
  }
}
